{
  "name": "frontend-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:autosave": "node --import ./tests/frontend/registerTsLoader.mjs --test tests/frontend/autosaveQueue.test.ts tests/frontend/characterAutosave.integration.test.ts",
    "test:frontend": "node --import ./tests/frontend/registerTsLoader.mjs --test tests/frontend/autosaveQueue.test.ts tests/frontend/characterAutosave.integration.test.ts tests/frontend/lojaCommands.test.ts tests/frontend/economyOperations.test.ts tests/frontend/raceChoices.test.ts tests/frontend/classProgression.test.ts tests/frontend/mundoVisibility.test.ts tests/frontend/attributeGeneration.test.ts tests/frontend/criticalRules.test.ts tests/frontend/statusRules.test.ts tests/frontend/progressionAndRecovery.test.ts tests/frontend/magicRules.test.ts",
    "generate:rules": "node --import ./tests/frontend/registerTsLoader.mjs tools/generate-public-rules.mjs",
    "check:rules-source": "node --import ./tests/frontend/registerTsLoader.mjs tools/generate-public-rules.mjs --check",
    "normalize:arsenal": "node tools/normalize-arsenal-balance.mjs",
    "audit:balance": "node tools/audit-balance.mjs",
    "check:typography": "node tools/check-site-typography.mjs",
    "fix:typography": "node tools/check-site-typography.mjs --fix",
    "fix:weapon-criticals": "node tools/normalize-weapon-criticals.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.108.0",
    "@react-three/fiber": "^8.16.8",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@studio-freight/lenis": "^1.0.42",
    "framer-motion": "^11.2.14",
    "gsap": "^3.15.0",
    "lucide-react": "^0.407.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "three": "^0.166.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.166.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
