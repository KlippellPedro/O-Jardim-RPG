# OS
.DS_Store
Thumbs.db
/nul

# Editor
.vscode/
*.suo
*.user

# Logs
*.log

# Segredos e configuracao local
.env
.env.*
!.env.example

# Node (caso use no futuro)
node_modules/
dist/
*.tsbuildinfo

# Ambientes locais
.venv/
.venv-test/

# Backups do banco: contem e-mails e hashes de senha, nunca vao para o git
backups/
*.jsonl.gz

# Cache do Python em qualquer pasta (tools/, scripts avulsos...)
__pycache__/
*.pyc
*.pyo

# Pacotes de deploy: sao gerados por tools/build-discloud-packages.ps1 a partir
# do codigo, entao versiona-los so incharia o repositorio.
*-discloud.zip

# Cache do pytest
.pytest_cache/

# Rascunhos e anexos deixados por sessoes de agente. Nada aqui e fonte.
.codex-remote-attachments/
UsersPedroAppDataLocalTemp*.json

# Moodboard de referencia visual do jogo 2D (Pinterest/web). Imagens de
# terceiros sem licenca confirmada nao podem ir pro historico do git, ver
# aviso em game/README.md. Fica so local, arquivo fontes.md guarda a origem
# de cada imagem.
game/referencias/

# Cache/import do editor do Godot (projeto do jogo 2D em game/). Gerado
# localmente a cada abertura do editor, nunca e fonte.
game/.godot/
game/*.translation
export_presets.cfg

# Documentos de mesa: HTML intermediario e perfil temporario do Chrome
docs/props/_html/
docs/players/_html/
docs/livro/_html/
